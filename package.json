{
  "name": "dsh-zhihu-tools",
  "version": "0.2.0",
  "type": "module",
  "description": "知乎插件：18 个工具（读取 + 发布文章，支持官方 OpenAPI 与网页会话两种授权）+ 本地设置页 + 精美卡片。反馈 QQ 群 1017854502: https://qm.qq.com/q/RAHJuyhQQ",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "dsh-plugin",
    "zhihu",
    "deepseek-harness",
    "deepseek",
    "harness"
  ],
  "author": "逐暝 (leolee9086)",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leolee9086/dsh-zhihu-tools.git"
  },
  "homepage": "https://github.com/leolee9086/dsh-zhihu-tools#readme",
  "bugs": {
    "url": "https://github.com/leolee9086/dsh-zhihu-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
